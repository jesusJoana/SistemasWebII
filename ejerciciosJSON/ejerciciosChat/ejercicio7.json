{
    "type":"object",
    "required":["titulo","nivel","duracionHoras","profesor","modulos"],
    "properties":{
        "titulo":{
            "type":"string"
        },
        "nivel":{
            "type":"string",
            "enum":["basico","intermedio","avanzado"]
        },
        "duracionHoras":{
            "type":"integer"
        },
        "profesor":{
            "type":"object",
            "required":["nombre","email"],
            "properties":{
                "nombre":{
                    "type":"string"
                },
                "email":{
                    "type":"string",
                    "format":"email"
                }
            }
        },
        "modulos":{
            "type":"array",
            "items":{
                "type":"object",
                "required":["titulo","lecciones"],
                "properties":{
                    "titulo":{
                        "type":"string"
                    },
                    "lecciones":{
                        "type":"integer"
                    }
                }
            }
        },
        "certificado":{
            "type":"boolean"
        }
    }
}