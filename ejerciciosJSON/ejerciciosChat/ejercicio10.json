{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties": false,
  "required": ["nombre","pais","online","eventos"],
  "properties": {
    "nombre":{
      "type":"string",
      "minLength": 4
    },
    "pais":{
      "type":"string"
    },
    "online":{
      "type":"boolean"
    },
    "eventos":{
      "type":"array",
      "minItems": 1,
      "$ref":"#/$defs/evento"
    }
  },
  "$defs":{
    "evento":{
      "type":"object",
      "additionalProperties": false,
      "required": ["codigo","titulo", "aforo", "categoria", "organizador", "participantes"],
      "properties": {
        "codigo":{
          "type":"string",
          "pattern": "^EVT-[0-9]{3}$"
        },
        "titulo":{
          "type":"string"
        },
        "aforo":{
          "type":"integer",
          "minimum": 1,
          "maximum": 100
        },
        "categoria":{
          "type":"string",
          "enum": ["tecnologia", "negocios", "salud", "educacion"]
        },
        "organizador":{
          "$ref":"#/defs/organizador"
        },
        "participantes":{
          "type":"array",
          "minItems": 1,
          "$ref":"#/defs/participante"
        }
      }
    },
    "organizador":{
      "type":"object",
      "additionalProperties": false,
      "required": ["nombre","email"],
      "properties": {
        "nombre":{
          "type":"string"
        },
        "email":{
          "type":"string",
          "format":"email"
        }
      }
    },
    "participante":{
      "type":"object",
      "additionalProperties": false,
      "required": ["dni", "nombre", "edad"],
      "properties": {
        "dni":{
          "type":"string",
          "pattern": "^[0-9]{8}[A-Z]$"
        },
        "nombre":{
          "type":"string"
        },
        "edad":{
          "type":"integer",
          "minimum": 18,
          "maximum": 120
        }
      }
    }
  }
}