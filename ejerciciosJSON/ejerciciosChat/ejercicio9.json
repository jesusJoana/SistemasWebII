{
    "type":"object",
    "required":["biblioteca","ubicacion","libros"],
    "properties":{
        "biblioteca":{
            "type":"string"
        },
        "ubicacion":{
            "type":"object",
            "required":["ciudad","direccion"],
            "properties":{
                "ciudad":{
                    "type":"string"
                },
                "direccion":{
                    "type":"string"
                }
            }
        },
        "libros":{
            "type":"array",
            "items":{
                "type":"object",
                "required":["titulo","autor","anio", "disponible","generos"],
                "properties":{
                    "titulo":{
                        "type":"string"
                    },
                    "autor":{
                        "type":"object",
                        "required":["nombre","nacionalidad"],
                        "properties":{
                            "nombre":{
                                "type":"string"
                            },
                            "nacionalidad":{
                                "type":"string"
                            }
                        }
                    },
                    "anio":{
                        "type":"integer"
                    },
                    "disponible":{
                        "type":"boolean"
                    },
                    "generos":{
                        "type":"array",
                        "items":{
                            "type":"string"
                        }
                    }
                }
            }
        },
        "prestamoOnline":{
            "type":"boolean"
        }
    }
}